---
/**
 * Before/after comparison. Drag, tap, or focus it and use the arrow keys.
 * `scroll` makes it wipe across as the page scrolls instead (and back again on the way up); where
 * scroll-driven CSS is missing or motion is reduced it stays a normal slider.
 * Slots: "before" and "after", one image each, same size. Only for real pairs.
 */
interface Props {
  label: string;
  ratio?: string;
  start?: number;
  scroll?: boolean;
}
const { label, ratio = '3 / 2', start = 50, scroll = false } = Astro.props;
---

<div class="ba" data-ba data-scroll={scroll ? '' : undefined} style={`--pos:${start}%;aspect-ratio:${ratio}`}>
  <div class="ba-layer"><slot name="before" /></div>
  <div class="ba-layer ba-after"><slot name="after" /></div>
  <span class="ba-handle" aria-hidden="true"></span>
  <input class="ba-range" type="range" min="0" max="100" value={start} aria-label={label} />
</div>

<style>
  @property --pos {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 50%;
  }
  .ba {
    position: relative;
    overflow: hidden;
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }
  .ba-layer {
    position: absolute;
    inset: 0;
  }
  .ba-layer :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  /* The "after" image shows to the right of the handle. */
  .ba-after {
    clip-path: inset(0 0 0 var(--pos));
  }
  .ba-handle {
    position: absolute;
    inset-block: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--ground, #fff);
    pointer-events: none;
  }
  .ba-handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--ground, #fff);
    border: 2px solid var(--ink, #111);
  }
  /* The range input is there for keyboards and screen readers; the pointer is handled on the box. */
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .ba:has(.ba-range:focus-visible) .ba-handle::after {
    outline: 3px solid var(--accent-strong, currentColor);
    outline-offset: 3px;
  }
  @keyframes ba-sweep {
    from { --pos: 100%; }
    to { --pos: 0%; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ba[data-scroll] {
        cursor: auto;
        /* Longhands: a minifier would fold the timeline into the shorthand and break it. */
        animation-name: ba-sweep;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: contain 0% contain 100%;
      }
      .ba[data-scroll] .ba-range {
        display: none;
      }
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.ba-range')!;
    const set = (v: number) => {
      const pos = Math.max(0, Math.min(100, v));
      range.value = String(pos);
      el.style.setProperty('--pos', `${pos}%`);
    };
    const fromPointer = (e: PointerEvent) => {
      const r = el.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };
    range.addEventListener('input', () => set(Number(range.value)));
    el.addEventListener('pointerdown', (e) => {
      el.setPointerCapture(e.pointerId);
      fromPointer(e);
    });
    el.addEventListener('pointermove', (e) => {
      if (el.hasPointerCapture(e.pointerId)) fromPointer(e);
    });
  });
</script>
